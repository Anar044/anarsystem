# SmartHoreca ZKTeco Connector
PORT=8081
BIND_HOST=0.0.0.0

# SmartHoreca cloud
SH_BASE_URL=https://smarthoreca.pages.dev
SH_INGEST_PATH=/api/hr/device-ingest
SH_HEARTBEAT_PATH=/api/hr/device-heartbeat

# Fallback token for a single-device installation.
# For several terminals prefer devices.json.
SH_DEVICE_TOKEN=

# ZKTeco terminal local time offset. Azerbaijan = UTC+4 = 240 minutes.
DEVICE_UTC_OFFSET_MINUTES=240
ADMS_TIMEZONE=4

# Local persistence
DATA_DIR=./data
DEVICES_FILE=./devices.json
FLUSH_INTERVAL_MS=3000
FLUSH_BATCH_SIZE=300
HEARTBEAT_INTERVAL_MS=30000
HTTP_TIMEOUT_MS=10000
MAX_QUEUE_ITEMS=50000
LOG_LEVEL=info
