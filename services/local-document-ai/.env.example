# Azerbaijani is a supported PaddleOCR language.
OCR_LANG=az
OCR_VERSION=PP-OCRv5

# Free CPU fallback for hard handwritten/free-form images.
# Set SECONDARY_OCR=off to disable it.
SECONDARY_OCR=easyocr
SECONDARY_OCR_LANGS=az,en

# Optional shared secret between Cloudflare and this service.
# Use a long random value in production.
LOCAL_AI_TOKEN=

# Optional local LLM. Leave blank for OCR + SmartHoreca heuristic parser only.
# If Ollama runs on Windows host while this service is in Docker:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
