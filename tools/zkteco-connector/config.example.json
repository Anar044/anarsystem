{
  "listen": {
    "host": "0.0.0.0",
    "port": 8088
  },
  "smartHoreca": {
    "baseUrl": "https://smarthoreca.pages.dev",
    "ingestPath": "/api/hr/device-ingest",
    "requestTimeoutMs": 15000
  },
  "attendance": {
    "timezone": "Asia/Baku",
    "utcOffset": "+04:00",
    "flushIntervalMs": 5000,
    "maxBatchSize": 200
  },
  "storage": {
    "queueFile": "./data/pending-events.jsonl",
    "logFile": "./data/connector.log"
  },
  "devices": {
    "YOUR_DEVICE_SERIAL": {
      "enabled": true,
      "name": "Main entrance",
      "model": "SenseFace 3A",
      "mode": "PUSH_ADMS",
      "deviceIp": "192.168.1.50",
      "devicePort": 4370,
      "deviceToken": "shd_REPLACE_WITH_TOKEN_FROM_SMARTHORECA"
    }
  }
}
