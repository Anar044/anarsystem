{
  "listen": {
    "host": "0.0.0.0",
    "port": 8088
  },
  "admin": {
    "key": "CHANGE_ME_OR_SET_ZK_GATEWAY_ADMIN_KEY"
  },
  "smartHoreca": {
    "baseUrl": "https://smarthoreca.pages.dev",
    "ingestPath": "/api/hr/device-ingest",
    "requestTimeoutMs": 15000
  },
  "attendance": {
    "timezone": "Asia/Baku",
    "utcOffset": "+04:00",
    "flushIntervalMs": 5000,
    "maxBatchSize": 200
  },
  "storage": {
    "queueFile": "./data/pending-events.jsonl",
    "logFile": "./data/gateway.log",
    "registryFile": "./data/device-registry.json"
  },
  "simulation": {
    "enabled": false
  },
  "devices": {}
}
