[Unit]
Description=SmartHoreca ZKTeco Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/smarthoreca-zkteco-gateway
Environment=NODE_ENV=production
EnvironmentFile=/etc/smarthoreca/zkteco-gateway.env
ExecStart=/usr/bin/node /opt/smarthoreca-zkteco-gateway/src/gateway.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/smarthoreca-zkteco-gateway/data

[Install]
WantedBy=multi-user.target
